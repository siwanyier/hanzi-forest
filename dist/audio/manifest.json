c": "audio/0111930eba211e33bf1d.mp3"}, "铅笔": {"src": "audio/f77e30ee1aed88192e4c.mp3"}, "长短": {"src": "audio/db9199a552fc87c8a0db.mp3"}, "门口": {"src": "audio/726c7da129e6e4a69aea.mp3"}, "阳光": {"src": "audio/ce9a0598434fd8092e28.mp3"}, "附近": {"src": "audio/263fa7d8fffddabeac5b.mp3"}, "雪花": {"src": "audio/4c1d79e56f4a54285d3a.mp3"}, "面条": {"src": "audio/0b5480e007c777a72600.mp3"}, "鞋子": {"src": "audio/a00b97bbc47f09ff831d.mp3"}, "颜色": {"src": "audio/070a8016fcc3dffbefd2.mp3"}, "飞机": {"src": "audio/c05f7cd6ed3587a2e538.mp3"}, "高山": {"src": "audio/323087e57195f7cf5f69.mp3"}, "鸭子": {"src": "audio/a2b1abc5a1cbc9672dc5.mp3"}, "黄色": {"src": "audio/d451c07d739b33060e74.mp3"}, "黑色": {"src": "audio/ed7d2c54184be5f5b81c.mp3"}, "鼻子": {"src": "audio/ba582ff45de430b3e0f8.mp3"}, "这里有一个苹果。": {"src": "audio/f9810bdec379de01b04e.mp3"}, "二月快要来了。": {"src": "audio/8813f707e2f1603abfd1.mp3"}, "树上有三个苹果。": {"src": "audio/1299186409ccd065add9.mp3"}, "人们在公园散步。": {"src": "audio/aebcee7be4e38e951675.mp3"}, "大象的鼻子很长。": {"src": "audio/44d57e05e06e57c556ec.mp3"}, "小鸟在树上唱歌。": {"src": "audio/9c93746afddd12a8f62e.mp3"}, "小鸟在树的上面。": {"src": "audio/dd82582f3854e3a72d74.mp3"}, "小猫在桌子下面。": {"src": "audio/1fcbe5062d484d3642b4.mp3"}, "小兔在门口等小熊。": {"src": "audio/bd417386ceee881ff9b5.mp3"}, "吃饭前要洗小手。": {"src": "audio/e837a4d8b2a3b3c3e787.mp3"}, "小动物们一起看日出。": {"src": "audio/9eb34270f536e541514c.mp3"}, "月亮出来了。": {"src": "audio/2a8300d83b246a39bbbc.mp3"}, "口渴了就喝水。": {"src": "audio/b0523b0085539a56ceed.mp3"}, "火苗很烫，不能碰。": {"src": "audio/1a63cae64e108ac1574c.mp3"}, "远处有一座高山。": {"src": "audio/90fd7ca5a67a5e4837f3.mp3"}, "小路上有一块石头。": {"src": "audio/f0362c6508429242b5fd.mp3"}, "这把椅子是木头做的。": {"src": "audio/81a02a31e5e737d6ac2f.mp3"}, "田地里长着小苗。": {"src": "audio/fae76d927a99b785af46.mp3"}, "小种子住在泥土里。": {"src": "audio/b27316b1455d0ac1376e.mp3"}, "天空中有白云。": {"src": "audio/6a78752e8999aec48500.mp3"}, "一朵白云飘过来。": {"src": "audio/fbed28ec249bf09ba44c.mp3"}, "下雨了，快撑伞。": {"src": "audio/7e2f63a7584214bf479b.mp3"}, "大风吹动了树叶。": {"src": "audio/70f4c5fca1b00b24c1f6.mp3"}, "花朵在春天开放。": {"src": "audio/3c855a6630255f807cb9.mp3"}, "小草从土里钻出来。": {"src": "audio/16ea2b1cacfe747560bb.mp3"}, "大树给小动物们遮太阳。": {"src": "audio/525d43af2e35d5609e60.mp3"}, "小鸟张开了翅膀。": {"src": "audio/48c4ddf87055511e1686.mp3"}, "小鱼在水里游。": {"src": "audio/3e2cff3e4bc37c3037c5.mp3"}, "叶子上有一只虫子。": {"src": "audio/86e9bed373e82ec152ae.mp3"}, "小马在草地上跑。": {"src": "audio/e988187019dc31cae128.mp3"}, "小牛在吃草。": {"src": "audio/2aed79f711cb5f406629.mp3"}, "山羊慢慢爬上山。": {"src": "audio/9c6c0aefdfdb7f5f08f2.mp3"}, "“我们”这个词里面有“我”字。": {"src": "audio/3bf8609ccc277d8fb283.mp3"}, "见到朋友说你好。": {"src": "audio/bd4f2ace5239cb9bd276.mp3"}, "他们在一起搭积木。": {"src": "audio/488bda8e82f215544d46.mp3"}, "“爸爸”这个词有两个“爸”字。": {"src": "audio/6817d548aa082aae5eba.mp3"}, "“妈妈”这个词有两个“妈”字。": {"src": "audio/883443faf39736cce584.mp3"}, "玩完了，小动物们回家。": {"src": "audio/8bb0bbbd8befbb74141b.mp3"}, "这只小猫真可爱。": {"src": "audio/a80d93ab880592cfdad6.mp3"}, "和朋友玩，小熊很开心。": {"src": "audio/c463a4a3a20e777462cb.mp3"}, "小兔子有白色的毛。": {"src": "audio/3f9e5ab6038d95e4b86d.mp3"}, "草莓是红色的。": {"src": "audio/1ab66ad47daa48b9178f.mp3"}, "有人轻轻地开门。": {"src": "audio/839e3699fabdbc9c7dec.mp3"}, "春天到了，桃树开花了。": {"src": "audio/73742d3c7441339ba939.mp3"}, "汽车停在路边。": {"src": "audio/2e1ccfb8504922138d4b.mp3"}, "种子慢慢长大。": {"src": "audio/6a5c71e1f9d8a4730de7.mp3"}, "大家的目光看向小鸟。": {"src": "audio/e4c5e72d3f599e282e5e.mp3"}, "兔子的耳朵长长的。": {"src": "audio/77827bb1c6b799f29ab3.mp3"}, "小熊和朋友一起踢足球。": {"src": "audio/712730647bf5eba742f9.mp3"}, "小猫坐在小动物们中间。": {"src": "audio/5af39a1e13cdfe814d81.mp3"}, "池塘里有四只小鸭。": {"src": "audio/84bf8ab8ec2a6936edf8.mp3"}, "小熊有五个小积木。": {"src": "audio/a21b236b7c72754ce50b.mp3"}, "早上六点，太阳出来了。": {"src": "audio/3f0b1d988b9b4ab8942c.mp3"}, "一个星期有七天。": {"src": "audio/f6f462bd1a9022064658.mp3"}, "草地上有八只蝴蝶。": {"src": "audio/bf532170770dd98dca42.mp3"}, "盒子里有九个球。": {"src": "audio/2ed4546dd722984a8b9e.mp3"}, "小熊有十个手指。": {"src": "audio/ea3f303ddf154bbab218.mp3"}, "你是小熊的好朋友。": {"src": "audio/296469a0d171e2bb9fdb.mp3"}, "小熊坐下来安静看书。": {"src": "audio/c66674eeb3ef87b79c03.mp3"}, "小熊听见了小鸟的歌声。": {"src": "audio/6c4bbd50d63f5f53cfc5.mp3"}, "小动物们轻轻说话。": {"src": "audio/29cba80bf82bce2da549.mp3"}, "小熊每天陪小熊读书。": {"src": "audio/0f60f1e93621f2f4f1a1.mp3"}, "小熊用铅笔写字。": {"src": "audio/1c0baebbef13b70755e4.mp3"}, "吃饭前先洗手。": {"src": "audio/824a4cc3cb0967fb091d.mp3"}, "跑步以后要喝水。": {"src": "audio/0fb9eb02b4287886aa4e.mp3"}, "走路时要看前面。": {"src": "audio/67e1995b5fce6b09bc0f.mp3"}, "小熊和小熊一起跑步。": {"src": "audio/dc11e99df0213015f371.mp3"}, "小熊在操场上跳绳。": {"src": "audio/da03744f652e89f244ce.mp3"}, "小朋友轻轻坐下。": {"src": "audio/c6f155742d308d51dd58.mp3"}, "小鹿请小熊站起来。": {"src": "audio/48ac0bcf8da217de174a.mp3"}, "小猫慢慢走过来。": {"src": "audio/919e58037070c8ec0163.mp3"}, "小动物们穿好鞋再出去。": {"src": "audio/7544d399ab644657f7de.mp3"}, "天黑了，小动物们回家。": {"src": "audio/562a2d863594595a19be.mp3"}, "太阳从云后出来了。": {"src": "audio/40d6d499588d4a00b72a.mp3"}, "公园的入口在前面。": {"src": "audio/81dd3488d7baaa2aa402.mp3"}, "小熊在房子里面。": {"src": "audio/3e5f9947395b53046e3f.mp3"}, "外面下起了小雨。": {"src": "audio/692fc51f5931953eae94.mp3"}, "小桥就在前面。": {"src": "audio/e4c337568936b7e8038e.mp3"}, "小狗跟在小熊的后面。": {"src": "audio/7fb58306374b3e9ed1a2.mp3"}, "小熊的左边有一棵树。": {"src": "audio/34c4f24f68c6aa36c0fe.mp3"}, "小熊的右边是一朵花。": {"src": "audio/209ee387dc2f0e379442.mp3"}, "树上结了很多果子。": {"src": "audio/74f754a27584319ac9c8.mp3"}, "冬天的虫子很少。": {"src": "audio/024ffd36b2929ac6f872.mp3"}, "小动物们比较两根绳子的长短。": {"src": "audio/1b1a9e39d3f4e19f54b6.mp3"}, "夏天小熊爱穿短裤。": {"src": "audio/33e4f0cbd908622d62eb.mp3"}, "高山上有白雪。": {"src": "audio/9bcbb063f04f25d4bcba.mp3"}, "进小门时要低头。": {"src": "audio/0b3e1cd5cabf054d5a5b.mp3"}, "早上起来说早安。": {"src": "audio/4b8fd2d9bfc62bd09ebd.mp3"}, "晚上小动物们一起看星星。": {"src": "audio/19464237060b8263a1c4.mp3"}, "明亮的月光照进窗。": {"src": "audio/a0e570cc7792c14bbe97.mp3"}, "树林里有小鸟。": {"src": "audio/6e33043ee205ffce1853.mp3"}, "森林里住着许多动物。": {"src": "audio/0f2e42efd82d2d78fd48.mp3"}, "小河里的水清清的。": {"src": "audio/fef587b6df936dbaf81b.mp3"}, "大海里有许多小鱼。": {"src": "audio/a2e4fa7a8f0d21b4a78e.mp3"}, "小动物们用沙子堆城堡。": {"src": "audio/a8435597e09b39faf661.mp3"}, "海浪轻轻拍着沙滩。": {"src": "audio/cd38589d909e6032c460.mp3"}, "沙滩上有一个贝壳。": {"src": "audio/2fe376db027edc6da393.mp3"}, "小船在水上轻轻摇。": {"src": "audio/c70728dc6f196cd21768.mp3"}, "飞机在天空中飞。": {"src": "audio/9125f7490c8ab6985396.mp3"}, "小熊坐飞机去看大海。": {"src": "audio/712d1d4592a4803ed6e3.mp3"}, "天黑了，小动物们打开电灯。": {"src": "audio/53ef2e4d06c61537c338.mp3"}, "小熊打开台灯看书。": {"src": "audio/c30979554945ac36b557.mp3"}, "小熊把书本摆整齐。": {"src": "audio/47f6cd5a37cb0ddd929b.mp3"}, "本子上画着一朵小花。": {"src": "audio/1988aaffa75a0909948f.mp3"}, "小熊用铅笔画小猫。": {"src": "audio/3df317d8e5af4f4bc226.mp3"}, "小动物们一起学习新本领。": {"src": "audio/7f8e26c911a444b4f646.mp3"}, "学校里有操场。": {"src": "audio/8811f01e5aa4fe5996f6.mp3"}, "小熊和朋友一起玩。": {"src": "audio/fae332091d70f2903938.mp3"}, "小动物们友好地打招呼。": {"src": "audio/40f9f87435008ca9893a.mp3"}, "小猫在窗边睡觉。": {"src": "audio/3b2592a76b2e5cba66f1.mp3"}, "小狗摇着尾巴。": {"src": "audio/b049ff9b9ae0d8e8f28c.mp3"}, "兔子爱吃青草。": {"src": "audio/8fb9b4459d381e3d101c.mp3"}, "鸭子在水里游泳。": {"src": "audio/a56b1721342e8d876913.mp3"}, "小鸡跟着小兔走。": {"src": "audio/260f7d2e4b6530bc0fd0.mp3"}, "小动物们每天吃水果。": {"src": "audio/69142f4cfbe6a66d73b5.mp3"}, "西瓜又大又圆。": {"src": "audio/cf7b49b05f2d920a1348.mp3"}, "大米可以煮成米饭。": {"src": "audio/865e565f33f2e1cd8fe2.mp3"}, "碗里的面条热乎乎。": {"src": "audio/e230314f6e0c4637f8c5.mp3"}, "小熊自己整理书包。": {"src": "audio/57879eefa4e730c6618b.mp3"}, "出门前穿好衣服。": {"src": "audio/a8dbccaf1af020a219de.mp3"}, "小熊的鞋子放在门口。": {"src": "audio/a4491e2f645e8906b026.mp3"}, "小熊的小床很舒服。": {"src": "audio/b8768d65697aae786afb.mp3"}, "小兔住在小房子里。": {"src": "audio/4188a3ef1bc67d55bfc8.mp3"}, "春天到了，小草绿了。": {"src": "audio/14213951caf085d67916.mp3"}, "夏天小动物们去海边。": {"src": "audio/773a634d51a9c8a019ac.mp3"}, "秋天的树叶变黄了。": {"src": "audio/0b426450c3546ad908ca.mp3"}, "冬天小动物们一起堆雪人。": {"src": "audio/acb8178f280083f7044f.mp3"}, "雪花轻轻落下来。": {"src": "audio/995d6f3863ddb1cb04bf.mp3"}, "晴天小动物们去公园。": {"src": "audio/5da09a453bda4bb06995.mp3"}, "星星在夜空中发亮。": {"src": "audio/3abec2a757e022155707.mp3"}, "天空中飞来一只鸟。": {"src": "audio/fc7b721884dcba5a088f.mp3"}, "太阳升起来了。": {"src": "audio/9a047838b6054a47ce56.mp3"}, "阳光照在草地上。": {"src": "audio/33529c14ede478d98d31.mp3"}, "今晚的月亮又圆又亮。": {"src": "audio/9ca5318edefe5cb9fe1b.mp3"}, "杯子里装着清水。": {"src": "audio/1da53cce069305c04421.mp3"}, "小草是绿色的。": {"src": "audio/ec4d964d8671d997fdff.mp3"}, "天空是蓝色的。": {"src": "audio/a58a6d0c0e8820c058e0.mp3"}, "小鸭子是黄色的。": {"src": "audio/e5effa121cfd9c2de2d3.mp3"}, "小猫的尾巴是黑色的。": {"src": "audio/20ab63def28f8db35719.mp3"}, "皮球是圆形的。": {"src": "audio/245e90957cafd6c0480c.mp3"}, "桌子是方形的。": {"src": "audio/7ef0af32e839d2012009.mp3"}, "远处有一座小山。": {"src": "audio/fd33c604516eb7035123.mp3"}, "小动物们家附近有公园。": {"src": "audio/0c408988fdcf5c55accb.mp3"}, "今天过得真快乐。": {"src": "audio/fc89dc1f9a329e2dd1c7.mp3"}, "小蜗牛慢慢向前爬。": {"src": "audio/dde27a13c2f9e6aabaa1.mp3"}, "小熊轻轻地关上门。": {"src": "audio/f7dc85ce7d1fc9ffbe34.mp3"}, "这块石头很重。": {"src": "audio/7c4bb3a5050d316fcbad.mp3"}, "冬天的风很冷。": {"src": "audio/45636913581a9779db40.mp3"}, "热水很烫，要小心。": {"src": "audio/abfbd46001e8c889a7cb.mp3"}, "小兔对小熊微笑。": {"src": "audio/79fdd9630813b3261128.mp3"}, "小松鼠摔倒后哭泣了。": {"src": "audio/594fc73a422350f2e6fa.mp3"}, "小熊很想念伙伴。": {"src": "audio/c813de3e4cd79c307117.mp3"}, "小熊找到了一片树叶。": {"src": "audio/4b1cc675bbaf3ea2bec7.mp3"}, "小熊把小花送给小兔。": {"src": "audio/51ac3ec2b72fdd2ed455.mp3"}, "小熊给伙伴帮忙。": {"src": "audio/f11a4e1ae4fd08e4c3cb.mp3"}, "吃饭以前要洗手。": {"src": "audio/082a4c19af8ff157a930.mp3"}, "小熊和朋友在公园玩耍。": {"src": "audio/501531bbc469dd8a1e22.mp3"}, "天黑了，小熊要睡觉。": {"src": "audio/cee06cc1eccc77459493.mp3"}, "早上小熊自己起床。": {"src": "audio/a83421d136ddd1ea3d12.mp3"}, "晚上九点，小熊准备睡觉。": {"src": "audio/690e37eb2b1afd2eb886.mp3"}, "小鱼在水里游泳。": {"src": "audio/19a2b4a21b8829967d36.mp3"}, "鸭子会在池塘游泳。": {"src": "audio/b46f13d3d41f3002563e.mp3"}, "小动物们走过一座小桥。": {"src": "audio/d178f075666734229a2d.mp3"}, "小路通向树林。": {"src": "audio/a45839cea2914e17096a.mp3"}, "小熊去公园放风筝。": {"src": "audio/d9ca06538b98e4e46e5b.mp3"}, "草地上开着小花。": {"src": "audio/481f17c4c420295a13f2.mp3"}, "一片树叶落下来。": {"src": "audio/b4e75e85f9fb45301e65.mp3"}, "树根在泥土里。": {"src": "audio/c0e5ebc060af4c973742.mp3"}, "小小的种子发芽了。": {"src": "audio/0586a1988e892e6977a3.mp3"}, "种子在春天发芽了。": {"src": "audio/068ff7bc120ce8ccd020.mp3"}, "一朵花向太阳开放。": {"src": "audio/a9f989df4ed0af490f6b.mp3"}, "河里有一条小鱼。": {"src": "audio/1e8d97ade039adc41e88.mp3"}, "树上有一只小鸟。": {"src": "audio/ed564a46d71fc461fdf2.mp3"}, "小熊种下一颗种子。": {"src": "audio/69153ba85f2cbcbbd3c0.mp3"}, "门前有一棵大树。": {"src": "audio/b273ff71ddd7d11caf4d.mp3"}, "桌上有一个苹果。": {"src": "audio/108840a5435f8c0b6384.mp3"}, "门口放着一把雨伞。": {"src": "audio/099409d018f9b9f47d88.mp3"}, "小熊用一张纸画画。": {"src": "audio/031e37ac4c72932e2be4.mp3"}, "小熊在白纸上画小船。": {"src": "audio/0156a1cd8b33b7cbcefc.mp3"}, "小熊喜欢画画。": {"src": "audio/6ed7e832d6c90b4c1209.mp3"}, "彩虹有美丽的颜色。": {"src": "audio/8ded194e0fb15744ccf3.mp3"}, "花园里的花很美丽。": {"src": "audio/bb936f8a6f2e4d426679.mp3"}, "小动物们看到了美丽的彩虹。": {"src": "audio/d582005b16ff60476fb0.mp3"}, "每天运动让身体更好。": {"src": "audio/17b06e2666e2a1fb859e.mp3"}, "小动物们要爱护自己的身体。": {"src": "audio/bdc458f14410ec1fc156.mp3"}, "小熊开心地点头。": {"src": "audio/7bb83bc45ad102309387.mp3"}, "早上起来先洗脸。": {"src": "audio/c6560ea547683e4d951d.mp3"}, "小熊的眼睛看到了彩虹。": {"src": "audio/7c35b1c85f66e68d175c.mp3"}, "看书久了让眼睛休息。": {"src": "audio/ab2776bda8b2b4d5e190.mp3"}, "大象的鼻子长长的。": {"src": "audio/fa5d002d3ef80bc723d1.mp3"}, "小鸟张开了嘴巴。": {"src": "audio/b3463984a8d5d4f50e2c.mp3"}, "小动物们早晚都要刷牙。": {"src": "audio/8bb6ab6c24106957db6b.mp3"}, "小鸟有柔软的羽毛。": {"src": "audio/269a0b8acd08ace56050.mp3"}, "小狗开心地摇尾巴。": {"src": "audio/00c70a68ed3e935bf824.mp3"}, "松鼠有一条大尾巴。": {"src": "audio/3e161a758677665f729a.mp3"}, "小熊和小兔来到海边。": {"src": "audio/e749af7f4874c8b89899.mp3"}, "小鱼在水里游，小鸟在天上飞。": {"src": "audio/854430b542ec6ace16dc.mp3"}, "小熊找到一个小小的贝壳。": {"src": "audio/fdac6469c913b1fb69d2.mp3"}, "“这是大海送给我的礼物！”": {"src": "audio/d2d0275ec8f83c8d5cd6.mp3"}, "小熊和小兔来到海边。小鱼在水里游，小鸟在天上飞。小熊找到一个小小的贝壳。“这是大海送给我的礼物！”": {"src": "audio/daf28dfbabee33a9ee57.mp3"}, "春天，一颗种子落在泥土里。": {"src": "audio/76cbb8ca90c6a3d316ff.mp3"}, "小雨来了，太阳也来了。": {"src": "audio/b2f0311e7454a695c4a3.mp3"}, "种子发芽，长出了绿叶。": {"src": "audio/da16a086899f79814bd8.mp3"}, "小鸟说：“你好，小树！”": {"src": "audio/c6f624f4508e4e3dd629.mp3"}, "春天，一颗种子落在泥土里。小雨来了，太阳也来了。种子发芽，长出了绿叶。小鸟说：“你好，小树！”": {"src": "audio/763279348e81ae205684.mp3"}, "晚上，小熊坐在窗前看书。": {"src": "audio/345dd71c2184b14e8d71.mp3"}, "月亮升起来，照着小小的房子。": {"src": "audio/c4f5f4b5c9692de917c5.mp3"}, "小兔说：“让眼睛休息一下吧。”": {"src": "audio/9719fca4c5a860560cea.mp3"}, "小熊看着月亮，轻轻说了声晚安。": {"src": "audio/43be844a36d5009d599a.mp3"}, "晚上，小熊坐在窗前看书。月亮升起来，照着小小的房子。小兔说：“让眼睛休息一下吧。”小熊看着月亮，轻轻说了声晚安。": {"src": "audio/9b72678054fdfd4f3e15.mp3"}, "小熊每天陪小兔读书。": {"src": "audio/47f202cd31592a3380aa.mp3"}, "小熊和小兔一起跑步。": {"src": "audio/cc9c6755a0369c571192.mp3"}, "小鸡在草地上走。": {"src": "audio/5b00281e419769a7e2b5.mp3"}, "小兔家附近有公园。": {"src": "audio/4f1e5d93c8ccbf0e09e7.mp3"}, "每天运动让身体更健康。": {"src": "audio/2481c8aecdd7e5cb28c5.mp3"}, "小兔口渴了，找来一杯水。": {"src": "audio/3a8b436a487cb46fdcef.mp3"}, "小熊的住所就在森林旁边。": {"src": "audio/f7df94699e9ce10e708c.mp3"}, "路上有来往的车辆。": {"src": "audio/43243cbe255f4eea8f01.mp3"}, "小雨已经停了，小兔收起雨伞。": {"src": "audio/89f9d8441e679c1bfa67.mp3"}, "小熊自己把书包整理好了。": {"src": "audio/4ca40f6a3fe20c04e227.mp3"}, "小树在未来会长得更高。": {"src": "audio/b2486d08a64144c29cf4.mp3"}, "周末，小兔准备去森林探险。": {"src": "audio/1d1fc1fd6dcfca93a9d1.mp3"}, "小熊把桌子擦得很干净。": {"src": "audio/5eaa85d6cdc8c22cc8df.mp3"}, "小鸟睡着了，树林里很安静。": {"src": "audio/070ca6a2a42993bfc503.mp3"}, "小兔说，请问小桥在哪里？": {"src": "audio/ca6a359fe361429b26e1.mp3"}, "找到了朋友，小熊的心情很好。": {"src": "audio/fd5c118edc8b782c2112.mp3"}, "出门以前，小兔准备好水和雨伞。": {"src": "audio/cf9becfc2b83de94d6cd.mp3"}, "小熊准备了一篮水果。": {"src": "audio/3395ecde57ba2376bbf0.mp3"}, "小兔知道小桥在哪里。": {"src": "audio/18cfebdb8a35c9274c12.mp3"}, "这条道路通向森林。": {"src": "audio/bfb714fb6534cc62c024.mp3"}, "小熊发现树下有一颗种子。": {"src": "audio/326279f42d62081c8507.mp3"}, "雨停以后，彩虹出现了。": {"src": "audio/0a42b2d10fa41dac3383.mp3"}, "因为下雨，小兔带上了雨伞。": {"src": "audio/7326adeca56dcbdb482e.mp3"}, "小兔带伞，是因为外面下雨了。": {"src": "audio/6394c5864ae45a2ff41e.mp3"}, "小熊口渴了，所以先喝一杯水。": {"src": "audio/8e6c6387f90190ce6482.mp3"}, "吃饭以后，小兔把桌子擦干净。": {"src": "audio/8d2f939c9d50d096364a.mp3"}, "小桥很窄，但是小兔想到了办法。": {"src": "audio/a5fc485a7ca8ea579169.mp3"}, "小兔点点头说，是的，这条路通向森林。": {"src": "audio/c03921b44e5bb9725de6.mp3"}, "突然，一阵风吹落了树叶。": {"src": "audio/53622da0abdfc0b5339a.mp3"}, "小兔先洗手，然后才吃水果。": {"src": "audio/1b0a7dfec3c427ece295.mp3"}, "走路时要注意前面的石头。": {"src": "audio/536031ec3a3bfcd8b6a4.mp3"}, "小兔明白了这句话的意思。": {"src": "audio/7cab4de35250f440012f.mp3"}, "小动物们一起保护森林。": {"src": "audio/0f8c747722ac9d663f98.mp3"}, "小熊很爱护自己的书本。": {"src": "audio/46c14d003121db965741.mp3"}, "温暖的阳光照在小树上。": {"src": "audio/da50fbc307f1d6990b0d.mp3"}, "太阳出来了，屋子里很暖和。": {"src": "audio/c654a033976a6e53880e.mp3"}, "书本在架子上摆得很整齐。": {"src": "audio/26b87a6821b0a7e4591c.mp3"}, "小动物们齐心把小路扫干净。": {"src": "audio/895bd543332dd9ab55d5.mp3"}, "小兔认真地读完了小故事。": {"src": "audio/3969bb5102c08ff876cf.mp3"}, "小熊认识了一个新朋友。": {"src": "audio/0e05486396d5af93a20d.mp3"}, "小兔喜欢坐在树下看书。": {"src": "audio/6340642f20f386ba3ca7.mp3"}, "森林里传来了欢乐的歌声。": {"src": "audio/90a58eddc2bb93c47dfc.mp3"}, "口渴": {"src": "audio/85755d8b4f8c7c16d2c8.mp3"}, "住所": {"src": "audio/f7107db329f699706994.mp3"}, "来往": {"src": "audio/d4a2c56136bbf107a164.mp3"}, "已经": {"src": "audio/8ee12e2310d9f00010cf.mp3"}, "自己": {"src": "audio/fb43354d2aaece5132e0.mp3"}, "未来": {"src": "audio/1da16551ff9f1dda9e8c.mp3"}, "周末": {"src": "audio/709b90ebf308c71e0126.mp3"}, "干净": {"src": "audio/535f2282f8c0549066fb.mp3"}, "安静": {"src": "audio/04403982ac176961e350.mp3"}, "请问": {"src": "audio/42be23d8344a497124dc.mp3"}, "心情": {"src": "audio/28f5b858887824066f0f.mp3"}, "准备": {"src": "audio/ddcf6e77b0ee10007e0b.mp3"}, "知道": {"src": "audio/d7b6472b11240bd231fe.mp3"}, "道路": {"src": "audio/a44c7ba211320a43e426.mp3"}, "发现": {"src": "audio/10493d06b90f6b186f60.mp3"}, "出现": {"src": "audio/105f559adeb990172c9a.mp3"}, "因为": {"src": "audio/795cfc96d4b55db76a8d.mp3"}, "所以": {"src": "audio/a2f7e42081a8eb137efd.mp3"}, "以后": {"src": "audio/e6ad7a1dbc1ede22e4c1.mp3"}, "但是": {"src": "audio/8cb1f721c82e7933889b.mp3"}, "是的": {"src": "audio/aa2a331d2dcf56680e51.mp3"}, "突然": {"src": "audio/8f8f93b58e2c33d30b22.mp3"}, "然后": {"src": "audio/ca4f5ee82e28628d1e14.mp3"}, "注意": {"src": "audio/4ffef8f3113a3a11ef5d.mp3"}, "意思": {"src": "audio/65eb352d08bf12a00b8a.mp3"}, "保护": {"src": "audio/0f810a7901cf042261fa.mp3"}, "爱护": {"src": "audio/e648363f309c3ea9f28d.mp3"}, "温暖": {"src": "audio/d2fbd6d61d7165bed8c0.mp3"}, "暖和": {"src": "audio/5c8f68d1574b48bb26b9.mp3"}, "整齐": {"src": "audio/b8f520189cb74b4433a8.mp3"}, "齐心": {"src": "audio/757db19580f0dbf9ace0.mp3"}, "认真": {"src": "audio/c8051ef2e9c0e5731d45.mp3"}, "认识": {"src": "audio/1c17dc403125481f9fcb.mp3"}, "喜欢": {"src": "audio/653b04330b75751f79b5.mp3"}, "欢乐": {"src": "audio/89d39328facd2650058e.mp3"}, "小兔和小熊从两边来到小桥前。": {"src": "audio/39d6a4b02b64c995e7c9.mp3"}, "桥很窄，一次只能过一个。": {"src": "audio/1c490ca3347ed681fd77.mp3"}, "小熊提着很重的篮子，小兔就往后退了两步。": {"src": "audio/3c769fe7f148f3f104b7.mp3"}, "等小熊过了桥，小兔才走上小桥。": {"src": "audio/5977b392988a24e9f5f4.mp3"}, "两个朋友都笑了。": {"src": "audio/556080aad83089fbb0a1.mp3"}, "小兔和小熊从两边来到小桥前。桥很窄，一次只能过一个。小熊提着很重的篮子，小兔就往后退了两步。等小熊过了桥，小兔才走上小桥。两个朋友都笑了。": {"src": "audio/4ef4ccace65fd2e062f9.mp3"}, "出门以前，小兔发现天空有很多乌云。": {"src": "audio/bfbe199c3a874257a504.mp3"}, "小兔把雨伞放进书包，然后去找小熊。": {"src": "audio/3cbfb5c3ffad22692bce.mp3"}, "走到小桥边，突然下起了雨。": {"src": "audio/920bba6351b6198999ba.mp3"}, "小兔打开雨伞，和小熊一起走回家。": {"src": "audio/1143105c8cb721715f0d.mp3"}, "到家以后，雨已经停了。": {"src": "audio/15de12b02fc9c00a97b8.mp3"}, "出门以前，小兔发现天空有很多乌云。小兔把雨伞放进书包，然后去找小熊。走到小桥边，突然下起了雨。小兔打开雨伞，和小熊一起走回家。到家以后，雨已经停了。": {"src": "audio/1871389b7bf0c22c6e05.mp3"}, "植物生长需要阳光和水。": {"src": "audio/f3ad5735d8b616e76420.mp3"}, "小兔和同伴一起过桥。": {"src": "audio/82d0ea8dbae797493edb.mp3"}, "小熊邀请伙伴一起看书。": {"src": "audio/beef620cfdfe8949028d.mp3"}, "小兔每天学习新的本领。": {"src": "audio/a724b2ba7c0b7ab7eff5.mp3"}, "小熊认真练习拍皮球。": {"src": "audio/97a2165daa266d52b591.mp3"}, "小兔每天练习，慢慢有了进步。": {"src": "audio/bdaaca88b78a88ddd1f3.mp3"}, "小动物们合作搭起一座小桥。": {"src": "audio/0a569ff094886ebd07d6.mp3"}, "小熊努力把积木搭得更高。": {"src": "audio/95b5cdc1b51ca9461781.mp3"}, "小兔完成了今天的练习。": {"src": "audio/cbe07405770b17f3fe7b.mp3"}, "小熊提出了一个问题。": {"src": "audio/189019de31bcfc3a3c33.mp3"}, "小兔在故事里找到了答案。": {"src": "audio/7a5a275d199445b1586c.mp3"}, "小熊选择了一条安全的小路。": {"src": "audio/b540e4dc897925b26712.mp3"}, "小兔蹲下来观察小蚂蚁。": {"src": "audio/b0c9280696246a784fc1.mp3"}, "小熊比较两片叶子的大小。": {"src": "audio/922110cd4956feac9356.mp3"}, "经常复习可以帮助记忆。": {"src": "audio/082e8d53b9f0aac25919.mp3"}, "两个伙伴一起解决了问题。": {"src": "audio/bb15dba446ee87bf7def.mp3"}, "小兔想知道比赛的结果。": {"src": "audio/6cbb3461c8cf9cfb6fd5.mp3"}, "小熊画下了种子发芽的过程。": {"src": "audio/64533a57ec6b11defe5d.mp3"}, "出门以前，首先要穿好鞋子。": {"src": "audio/4c2ca876d9526324690c.mp3"}, "最后，小动物们一起回家了。": {"src": "audio/e0820cd563ba36765ceb.mp3"}, "小兔真正明白了故事的意思。": {"src": "audio/0e4b7fbf4debc2a450a9.mp3"}, "小河里的水一直向前流。": {"src": "audio/82b51b8ed20f7e8c2ef0.mp3"}, "今天的天空又蓝又亮。": {"src": "audio/601ff1174a17a504fdfc.mp3"}, "教室里的桌椅摆得很整齐。": {"src": "audio/62adc8163441f21ef8fa.mp3"}, "小熊打开窗户，让空气流进来。": {"src": "audio/77b03eb6c6a1dae2afa1.mp3"}, "桌椅擦得干干净净。": {"src": "audio/cca2e00b2d4125f46098.mp3"}, "小兔把厨房收拾干净了。": {"src": "audio/bee9612c0f1f7349d075.mp3"}, "小熊在客厅里搭积木。": {"src": "audio/3211feb41ec7634d42e3.mp3"}, "卧室里放着一张小床。": {"src": "audio/b74c3287955eb748df87.mp3"}, "小兔沿着楼梯慢慢往上走。": {"src": "audio/0b5f2a913833d593442e.mp3"}, "墙壁上挂着一幅画。": {"src": "audio/ed9ea09010cfd0da07a0.mp3"}, "小熊对着镜子整理衣服。": {"src": "audio/11926b7176e95f7d84c6.mp3"}, "洗完脸，要用干净的毛巾擦一擦。": {"src": "audio/c248bfd8cce9e213de93.mp3"}, "小兔拿起牙刷认真刷牙。": {"src": "audio/821ba0bab9cf9e4d0ae6.mp3"}, "洗手时可以用肥皂搓一搓。": {"src": "audio/9accdbdc8d3993320606.mp3"}, "小熊把杯碗放到桌子上。": {"src": "audio/2c30d92c88965f61a8f9.mp3"}, "小兔用筷子夹起一小块豆腐。": {"src": "audio/56377910d9cbc177ecfa.mp3"}, "小熊用勺子喝汤。": {"src": "audio/4a4d707a52265743e9bb.mp3"}, "盘子里放着切好的水果。": {"src": "audio/aff52cabdb18edcfb5b1.mp3"}, "瓶子里装着清水。": {"src": "audio/d58d807088dd0a7f62aa.mp3"}, "小兔提着篮子去摘果子。": {"src": "audio/f554453cf5650394c46e.mp3"}, "小熊把玩具收进箱子。": {"src": "audio/3d9e0063632198479331.mp3"}, "柜子里放着整齐的衣服。": {"src": "audio/67288517ce3b661e2ac6.mp3"}, "小兔看着钟表，知道该出门了。": {"src": "audio/bbba3fc5fc4a3f6fe719.mp3"}, "闹钟响了，小熊准备起床。": {"src": "audio/ed62d5f4270bdbc66e08.mp3"}, "地球是小动物们共同的家园。": {"src": "audio/4c77501095a511372a23.mp3"}, "雨后的空气很清新。": {"src": "audio/2fcdc72352fc3399a930.mp3"}, "小兔想看看更大的世界。": {"src": "audio/ceb70e8be5721c31c591.mp3"}, "小熊在地图上找到了南北方向。": {"src": "audio/18fa31bdb53ff1c43770.mp3"}, "太阳每天从东边升起。": {"src": "audio/bb15fc14ddc17b861013.mp3"}, "太阳慢慢落向西方。": {"src": "audio/c0277c33a67feee0ab1d.mp3"}, "城市里有高楼和公园。": {"src": "audio/34f523c45840e89d570e.mp3"}, "乡村的小路两边种着庄稼。": {"src": "audio/5ec49e1852d576e55dbe.mp3"}, "街道上的车辆慢慢向前走。": {"src": "audio/5ec01fe4814adc3ef9a0.mp3"}, "小兔去商店买了一本书。": {"src": "audio/2d4573beb6e9cb55f6a0.mp3"}, "小兔轻轻推门走进屋里。": {"src": "audio/a6792655848a32752ebb.mp3"}, "过桥时，小动物们互相拉手。": {"src": "audio/991d6edd8abc839da261.mp3"}, "小熊抬头看见了白云。": {"src": "audio/0d7afc60067e161e0096.mp3"}, "小兔在草地上练习拍球。": {"src": "audio/03fe08a05ebe11c463fb.mp3"}, "小熊伸出手，接住了皮球。": {"src": "audio/35b365bee9c1215b4b60.mp3"}, "小兔轻轻扔球，传给旁边的伙伴。": {"src": "audio/c8e6960deb65925476e0.mp3"}, "小熊和伙伴一起踢球。": {"src": "audio/415a071f0416e77d3d53.mp3"}, "小兔捡起了地上的纸片。": {"src": "audio/c5bdda64c5f6a1e83521.mp3"}, "小熊轻轻放下手里的篮子。": {"src": "audio/aa0581bcd26ddd1d549f.mp3"}, "小兔拿起铅笔开始画画。": {"src": "audio/a9a67ff3f3cd319bee02.mp3"}, "小熊每天帮忙扫地。": {"src": "audio/1877fa418e6f106a1227.mp3"}, "小兔拿着抹布擦桌。": {"src": "audio/7da2f7034f3fc0f31a93.mp3"}, "小熊轻轻关门，没有吵醒小猫。": {"src": "audio/7161113f29b5c4494402.mp3"}, "小兔起床后先穿衣。": {"src": "audio/9e1552d49acc9fcfe99c.mp3"}, "走进屋子以后，小熊先脱鞋。": {"src": "audio/05a9ed51e1d81fbb3f6b.mp3"}, "小兔伸手接住了一片落叶。": {"src": "audio/0f9a83330be1632c3fd0.mp3"}, "小熊弯腰捡起一颗小石头。": {"src": "audio/a0c1c9a7038be196c119.mp3"}, "想说话的小兔先举手。": {"src": "audio/1671f92e166883b1b094.mp3"}, "小路在大树旁边转弯。": {"src": "audio/a03b8e4066a997d39293.mp3"}, "到达车站以后，司机慢慢停车。": {"src": "audio/7896bcc518b85c480442.mp3"}, "小兔在树下等待伙伴。": {"src": "audio/fe8a2542b4a5cddd60d2.mp3"}, "小动物们排队走过小桥。": {"src": "audio/5bf90a6052feeea2f94c.mp3"}, "小熊抱紧了怀里的大皮球。": {"src": "audio/459a3cbfdad036a40444.mp3"}, "两个朋友见面时互相拥抱。": {"src": "audio/ac8a77528ff40b4cff77.mp3"}, "树枝随着风轻轻摇摆。": {"src": "audio/207216a54ddb47f70def.mp3"}, "小球沿着草地慢慢滚动。": {"src": "audio/edb4f802e9d460084b2b.mp3"}, "小狗在草地上追赶皮球。": {"src": "audio/4b202388b5422a4c4f41.mp3"}, "小猫躲藏在大树后面。": {"src": "audio/761ac5b1130c1f6b7dac.mp3"}, "篮子里放着红红的苹果。": {"src": "audio/285c5b1604c2170065e8.mp3"}, "小猴子剥开一根香蕉。": {"src": "audio/62beaab9b4028e1f5622.mp3"}, "小兔把橘子分给了伙伴。": {"src": "audio/63055813f0786f7cd0c9.mp3"}, "架子上挂着一串紫色的葡萄。": {"src": "audio/b146b1077e073b618c3b.mp3"}, "柠檬闻起来清香，吃起来有点酸。": {"src": "audio/baf27af7d69fdb6dc49c.mp3"}, "树上结着又大又甜的桃子。": {"src": "audio/0d82125df9c6bbaa97aa.mp3"}, "盘子里的梨子又甜又多汁。": {"src": "audio/d2499fb09fe39e8d2875.mp3"}, "菜园里种着各种蔬菜。": {"src": "audio/673aa27c527c999c20de.mp3"}, "小兔从土里拔出一根萝卜。": {"src": "audio/2d18ec1b2940dd94a90f.mp3"}, "熟透的番茄红红的。": {"src": "audio/1a0e5bb94d708b81120f.mp3"}, "架子上挂着长长的豆角。": {"src": "audio/f679b79d2599aeaff366.mp3"}, "小兔剥开豆荚，看到圆圆的豌豆。": {"src": "audio/5e90af099d9e6c64dfdb.mp3"}, "玉米粒在阳光下亮晶晶的。": {"src": "audio/38418149aa47955f28a1.mp3"}, "田里的麦子慢慢变黄了。": {"src": "audio/f06b99266b642ec4749a.mp3"}, "小动物们把粮食放进仓库。": {"src": "audio/d16af0c30f834de04ab6.mp3"}, "小熊把饼干分成小块。": {"src": "audio/add8249dac66ee5ed127.mp3"}, "桌上放着一个小小的蛋糕。": {"src": "audio/b82d76393a29584d0617.mp3"}, "小兔早餐喝了一杯牛奶。": {"src": "audio/c791a0a36d06a3b93a3b.mp3"}, "这颗果子的味道酸甜酸甜的。": {"src": "audio/f57169776ca869ac3fe7.mp3"}, "一只蝴蝶轻轻停在花朵上。": {"src": "audio/a8b74d73fa2e863a8697.mp3"}, "蜻蜓在小河上方飞来飞去。": {"src": "audio/b8e5782764f0121148a6.mp3"}, "蚂蚁排着队搬运食物。": {"src": "audio/8f52b8e0705ed3582f82.mp3"}, "蜘蛛在树枝之间结了一张网。": {"src": "audio/3356352b21d3203b492a.mp3"}, "蜗牛背着小房子慢慢爬。": {"src": "audio/bbb9af341b0fef47a706.mp3"}, "乌龟伸出脑袋看了看。": {"src": "audio/fa0ab0d7fc0f5df6ac16.mp3"}, "熊猫抱着竹子慢慢吃。": {"src": "audio/d565abf960778cda4168.mp3"}, "小狐狸在森林里寻找果子。": {"src": "audio/9fd93a545fd52f235911.mp3"}, "狮子在树下安静地休息。": {"src": "audio/5351fce46414d12c73ad.mp3"}, "老虎身上有一条条花纹。": {"src": "audio/cd8443c05e7883bc1e7f.mp3"}, "猴子灵活地爬到树枝上。": {"src": "audio/2c24f35732a2f7347b97.mp3"}, "松鼠把松果藏进树洞。": {"src": "audio/e315f33055653bdada30.mp3"}, "骆驼在沙地上慢慢走。": {"src": "audio/2bd564e9460e6113661a.mp3"}, "斑马身上有黑白相间的条纹。": {"src": "audio/38dfb0e4023cf0fd5f6b.mp3"}, "大象用长鼻子卷起一根木头。": {"src": "audio/6023416fde66f6ce3201.mp3"}, "企鹅摇摇摆摆地走向海边。": {"src": "audio/a3d36a73f27adf5bc6ad.mp3"}, "海豚从水面跃了出来。": {"src": "audio/f3ac15baa402fb0fa5a3.mp3"}, "鲸鱼在大海里慢慢游。": {"src": "audio/4a4b064440b58177df95.mp3"}, "鲨鱼摆动尾巴向前游。": {"src": "audio/a494c14430a8878b4966.mp3"}, "螃蟹横着走进沙洞。": {"src": "audio/daa8ae64144373783321.mp3"}, "小鱼游过水草，看到了虾米。": {"src": "audio/58cb990da4818c5e297d.mp3"}, "大树的枝干伸向天空。": {"src": "audio/ad74eac6ed186bbaf160.mp3"}, "春雨以后，竹笋从土里钻出来。": {"src": "audio/00b2872bd69023e34b82.mp3"}, "雨后，树下长出了小蘑菇。": {"src": "audio/bb9a5bab19bf1f16ee96.mp3"}, "花园里的玫瑰开花了。": {"src": "audio/46815138a7bce7723baf.mp3"}, "秋天的菊花开得很美丽。": {"src": "audio/3fd5a315787abd055020.mp3"}, "池塘里的荷花轻轻摇动。": {"src": "audio/1868edbefaad5f2c736e.mp3"}, "小鸭子在池塘里游泳。": {"src": "audio/5a90b593f95e43ba38aa.mp3"}, "远处的湖泊像一面镜子。": {"src": "audio/15f6c5f99640fc2f9b9c.mp3"}, "清清的溪流绕过小山。": {"src": "audio/a19dc47ff4a5a7293376.mp3"}, "瀑布从高高的山崖落下来。": {"src": "audio/6ef73d5d6b72912a06dd.mp3"}, "小动物们在沙滩上堆城堡。": {"src": "audio/6802c22aa3958ab60d96.mp3"}, "一阵阵波浪轻轻拍着小船。": {"src": "audio/74bcc7a6d837c0823c5e.mp3"}, "大海中有一座绿色的岛屿。": {"src": "audio/8c9f1a59c8971616e829.mp3"}, "雨后，天空出现了一道彩虹。": {"src": "audio/b32bcf1314e3d4f12610.mp3"}, "远处传来轰隆隆的雷声。": {"src": "audio/99edc9f9a7ebe4220774.mp3"}, "闪电照亮了乌黑的天空。": {"src": "audio/615b568798e680ce377d.mp3"}, "冰雹落在空地上，发出轻轻的响声。": {"src": "audio/da2c6112d05832787176.mp3"}, "清晨，叶子上挂着晶亮的露珠。": {"src": "audio/74f692858f3643ae1a72.mp3"}, "小熊丢了玩具，有一点伤心。": {"src": "audio/66370bc0b7d9cdcf0a4a.mp3"}, "夜里听到陌生的声音，小兔有些害怕。": {"src": "audio/da12ed2fe8c53338700c.mp3"}, "小熊担心小苗缺水，连忙去浇水。": {"src": "audio/dff2c36819e9bd6d319a.mp3"}, "小兔第一次上台，有一点害羞。": {"src": "audio/487eae2da44ad4d362a7.mp3"}, "小熊为伙伴的进步感到骄傲。": {"src": "audio/c29ddb50d9ca89a58a4e.mp3"}, "小兔是一个诚实的好伙伴。": {"src": "audio/b6e427111bfe31e67bbc.mp3"}, "小动物们相信合作可以完成任务。": {"src": "audio/a343bbca32bc77e9e8d0.mp3"}, "小兔的愿望是种出一棵大树。": {"src": "audio/2bfedb75aa2dc037d2c6.mp3"}, "小熊希望明天是个晴天。": {"src": "audio/b303a41cb348ceb2efd9.mp3"}, "小兔的梦想是乘着小船看大海。": {"src": "audio/fd60cceeea34ee70fa3d.mp3"}, "经常运动可以让身体更健康。": {"src": "audio/b463b6c5de63d66083c8.mp3"}, "小熊躺在草地上，觉得很舒服。": {"src": "audio/eecd1b624d79a172b368.mp3"}, "小兔走了很久，感到有些疲倦。": {"src": "audio/7f9a9a818175db06f0b3.mp3"}, "睡了一觉，小熊又有精神了。": {"src": "audio/ccca117d88db0dc6df64.mp3"}, "动物": {"src": "audio/7ebb07e850a404af9945.mp3"}, "植物": {"src": "audio/a745bfdf30053f763380.mp3"}, "同伴": {"src": "audio/178612a11fb0dbcfc823.mp3"}, "伙伴": {"src": "audio/bfaa81614aa9c1d874e1.mp3"}, "练习": {"src": "audio/3cae1f75ef71137038e1.mp3"}, "进步": {"src": "audio/3cd4b73afa842451b683.mp3"}, "合作": {"src": "audio/54af4ede4ca009cc5ddb.mp3"}, "努力": {"src": "audio/abe26aa668de1e20fb27.mp3"}, "完成": {"src": "audio/c0b3fbff51ccc40b8bf1.mp3"}, "问题": {"src": "audio/33a8618cb6710e43488a.mp3"}, "答案": {"src": "audio/ce820ae814b908c7c037.mp3"}, "选择": {"src": "audio/c11330b85234f9c0ad40.mp3"}, "观察": {"src": "audio/f262badacb76ab43faae.mp3"}, "比较": {"src": "audio/fb8791a7645ec8e37e1e.mp3"}, "记忆": {"src": "audio/7a6335b379b9a161a819.mp3"}, "解决": {"src": "audio/5516eb8280b50ab4b294.mp3"}, "结果": {"src": "audio/bb7ef73495dd8a74eead.mp3"}, "过程": {"src": "audio/15b18a0a2ad921654e7e.mp3"}, "首先": {"src": "audio/01dd96a3885b84a2f9e7.mp3"}, "最后": {"src": "audio/445905122e87b9907cf5.mp3"}, "真正": {"src": "audio/858755f4f1b3bd13123d.mp3"}, "一直": {"src": "audio/5a2650501f0eb052db03.mp3"}, "今天": {"src": "audio/d5f5a7a010731feb6cc6.mp3"}, "教室": {"src": "audio/df7a65bb1371b4419398.mp3"}, "窗户":